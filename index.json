globalThis.SynthetiqModule={searchResults:async function(q){try{const u="https://api.mangadex.org/manga?title="+encodeURIComponent(q)+"&translatedLanguage[]=fr&limit=20&includes[]=cover_art",r=await fetchv2(u,{"Accept":"application/json"}),j=await r.json();return j.data&&Array.isArray(j.data)?{items:j.data.map(i=>{const c=i.relationships.find(x=>x.type==="cover_art");return{id:i.id,title:i.attributes.title.fr||i.attributes.title.en||Object.values(i.attributes.title)[0],href:i.id,image:c&&c.attributes?`https://uploads.mangadex.org/covers/${i.id}/${c.attributes.fileName}.256.jpg`:""}}),hasMore:!1}:{items:[],hasMore:!1}}catch(e){return{items:[],hasMore:!1}}},extractDetails:async function(i){try{const u="https://api.mangadex.org/manga/"+i.split("/").pop(),r=await fetchv2(u,{"Accept":"application/json"}),j=await r.json();return{id:i.split("/").pop(),title:j.data.attributes.title.fr||j.data.attributes.title.en||Object.values(j.data.attributes.title)[0],description:(j.data.attributes.description.fr||"").replace(/<[^>]+>/g,""),image:""}}catch(e){return null}},extractChapters:async function(i){try{const u="https://api.mangadex.org/manga/"+i.split("/").pop()+"/feed?translatedLanguage[]=fr&limit=100",r=await fetchv2(u,{"Accept":"application/json"}),j=await r.json();return j.data&&Array.isArray(j.data)?j.data.map(c=>({id:c.id,title:"Chapitre "+(c.attributes.chapter||"?"),href:c.id})):[]}catch(e){return[]}},extractImages:async function(c){try{const u="https://api.mangadex.org/at-home/server/"+c.split("/").pop(),r=await fetchv2(u,{"Accept":"application/json"}),j=await r.json();return j.chapter.data.map(f=>j.baseUrl+"/data/"+j.chapter.hash+"/"+f)}catch(e){return[]}}};
